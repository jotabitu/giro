# Giro, produção (opção B da ADR 0033: uma VPS com tudo em Compose): segredos de INFRAESTRUTURA.
# Ficam num config separado do cofre (Doppler `prd_infra` ou projeto `giro-infra` do Bitwarden
# Secrets Manager), porque a aplicação não pode ter a credencial de backup nem a do DNS (ADR 0033,
# item 6). O arquivo gerado tem permissão 600. Nunca coloque valor real aqui. Variável sem valor é
# de preenchimento obrigatório.
# Uso: docker compose -f infra/deploy/docker-compose.producao.yml \
#        --env-file producao.env --env-file producao-infra.env up -d

# --- PostgreSQL 16 e Redis (só dentro da rede do compose, sem porta publicada) ---
POSTGRES_DB=giro
POSTGRES_USER=giro
# Superusuário do contêiner: só cria o banco e os papéis na primeira subida e serve ao pgBackRest.
POSTGRES_PASSWORD=
# Papéis da ADR 0016 (infra/postgres/01-papeis.sh). As mesmas senhas entram em DATABASE_URL
# (giro_app) e DATABASE_URL_MIGRACAO (giro_migracao) do producao.env.
POSTGRES_PASSWORD_MIGRACAO=
POSTGRES_PASSWORD_APP=
# Mesma senha de REDIS_URL, CELERY_BROKER_URL e CELERY_RESULT_BACKEND do producao.env.
REDIS_SENHA=

# --- Backup do banco: pgBackRest, cifrado, para um bucket de OUTRO provedor (Backblaze B2 ou
# Cloudflare R2), retenção de 30 dias (ADR 0033, itens 1 e 2) ---
PGBACKREST_REPO1_S3_BUCKET=
# B2: s3.<regiao>.backblazeb2.com · R2: <conta>.r2.cloudflarestorage.com
PGBACKREST_REPO1_S3_ENDPOINT=
PGBACKREST_REPO1_S3_REGION=
PGBACKREST_REPO1_S3_KEY=
PGBACKREST_REPO1_S3_KEY_SECRET=
# Chave da cifra AES-256 do repositório (openssl rand -base64 48). Guarde UMA CÓPIA com o dono,
# fora do provedor e do cofre: sem ela o backup não abre.
PGBACKREST_REPO1_CIPHER_PASS=

# --- Backup dos arquivos (fotos, documentos): rclone espelha o bucket de arquivos e o restic
# guarda cifrado no bucket de backup, também com retenção de 30 dias ---
# Bucket de arquivos da aplicação, somente leitura para este usuário (rclone, remoto `origem`).
ARQUIVOS_S3_ENDPOINT=
ARQUIVOS_S3_REGIAO=
ARQUIVOS_S3_BUCKET=
ARQUIVOS_S3_CHAVE_LEITURA=
ARQUIVOS_S3_SEGREDO_LEITURA=
# Repositório do restic: s3:https://<endpoint>/<bucket>/arquivos
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Certificado curinga (Let's Encrypt, desafio DNS-01 na Cloudflare) ---
# Token da Cloudflare só com a permissão Zone > DNS > Edit na zona do domínio. Vira o arquivo
# cloudflare.ini (permissão 600) pelo script de subida.
CLOUDFLARE_API_TOKEN=
# E-mail dos avisos da Let's Encrypt.
CERTBOT_EMAIL=

# --- Monitoramento (infra/monitoramento/verificar.sh) ---
# Alerta por e-mail (SMTP com TLS) para o dono e para quem estiver de plantão.
ALERTA_SMTP_URL=smtps://smtp.exemplo.com:465
ALERTA_USUARIO=
ALERTA_SENHA=
ALERTA_DE=
# Vários destinatários separados por vírgula.
ALERTA_PARA=
# Opcional: URL de ping de um serviço de "batimento" (Healthchecks.io, plano gratuito). Chamada a cada
# verificação boa; se a VPS morrer, o serviço avisa por falta de ping.
BATIMENTO_URL=

# --- Acesso ao Django Admin (ADR 0029) ---
# Linhas `<ip> 1;` (como em producao.admin-ips.conf.example) separadas por "\n" literal; o script
# de segredos grava em admin-ips.conf. Vazio = Admin fechado (404 para todos). Só IPs da equipe.
ADMIN_IPS=
