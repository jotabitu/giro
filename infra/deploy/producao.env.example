# Giro, produção: só o que muda em relação ao .env.example. Copie para o cofre do ambiente.
# Nunca coloque valor real aqui. Variável sem valor é de preenchimento obrigatório.
DJANGO_SETTINGS_MODULE=config.settings.prod
DOMINIO_BASE=girolocadoras.com.br
DJANGO_ALLOWED_HOSTS=.girolocadoras.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://admin.girolocadoras.com.br
DJANGO_SECRET_KEY=
JWT_SIGNING_KEY=
DJANGO_HSTS_SEGUNDOS=31536000
DJANGO_HSTS_PRELOAD=1
GIRO_EXPOR_DOCUMENTACAO_DA_API=0
# O proxy reverso manda /api/ direto ao Django e acrescenta o IP do cliente (ADR 0018).
# GIRO_REDES_PROXY: sub-rede (CIDR) de onde o proxy chega ao Django. Obrigatória; prod.py recusa
# vazia, inválida ou 0.0.0.0/0. O valor abaixo é um exemplo: troque pela rede real do ambiente.
GIRO_PROXIES_CONFIAVEIS=1
GIRO_REDES_PROXY=10.10.0.0/24
# Geradas por ambiente e guardadas no cofre (comandos em .env.example). Não reutilize as de outro ambiente.
GIRO_CHAVE_DADOS_PESSOAIS=
GIRO_CHAVE_SEGREDOS=
GIRO_PEPPER_HMAC=
# Papéis separados (ADR 0016): giro_app em DATABASE_URL; giro_migracao só no job de deploy
# (o serviço `migrar` do compose). Postgres e Redis só com senha (T-274): prod.py recusa URL sem
# senha, e o Redis tem de subir com `requirepass` (ou ACL) e, fora da rede interna, com TLS.
#   DATABASE_URL=postgres://giro_app:<senha>@<host>:5432/giro
#   DATABASE_URL_MIGRACAO=postgres://giro_migracao:<senha>@<host>:5432/giro
#   REDIS_URL=redis://:<senha>@<host>:6379/0 (rediss:// com TLS; o broker usa /1 e o resultado /2)
DATABASE_URL=
DATABASE_URL_MIGRACAO=
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# Integrações reais (T-157): prod.py recusa e-mail no console, locmem, arquivo ou dummy,
# SMTP sem EMAIL_HOST, armazenamento diferente de s3 e pagamentos falso ou sem chave.
# No cofre, preencher: EMAIL_HOST (servidor SMTP; vazio derruba o processo), EMAIL_HOST_USER e
# EMAIL_HOST_PASSWORD (conta SMTP), GIRO_ARMAZENAMENTO=s3 (fixo), os S3_* abaixo,
# GIRO_PROVEDOR_PAGAMENTOS=asaas (fixo) e GIRO_ASAAS_CHAVE_API (chave do ambiente Asaas
# correspondente; vazia derruba o processo). Opcionais: EMAIL_PORT (587, com TLS) e EMAIL_FROM.
# S3_BUCKET, S3_CHAVE_DE_ACESSO e S3_CHAVE_SECRETA: prod.py recusa vazios ou ausentes (T-266).
# S3_ENDPOINT_URL e S3_REGIAO podem ficar vazios: a AWS usa os padrões do boto3.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
GIRO_ARMAZENAMENTO=s3
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGIAO=
S3_CHAVE_DE_ACESSO=
S3_CHAVE_SECRETA=
GIRO_PROVEDOR_PAGAMENTOS=asaas
GIRO_ASAAS_URL=https://api.asaas.com/v3
GIRO_ASAAS_CHAVE_API=
SENTRY_ENVIRONMENT=producao
# Gunicorn (infra/docker/gunicorn.conf.py, T-258). Opcionais; os valores abaixo são os do ambiente.
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=30
