# Giro, produção: só o que muda em relação ao .env.example. Copie para o cofre do ambiente.
# Nunca coloque valor real aqui. Variável sem valor é de preenchimento obrigatório.
DJANGO_SETTINGS_MODULE=config.settings.prod
DOMINIO_BASE=girolocadoras.com.br
DJANGO_ALLOWED_HOSTS=.girolocadoras.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://admin.girolocadoras.com.br
DJANGO_SECRET_KEY=
JWT_SIGNING_KEY=
DJANGO_HSTS_SEGUNDOS=31536000
DJANGO_HSTS_PRELOAD=1
GIRO_EXPOR_DOCUMENTACAO_DA_API=0
# O proxy reverso manda /api/ direto ao Django e acrescenta o IP do cliente (ADR 0018).
# GIRO_REDES_PROXY: sub-rede (CIDR) de onde o proxy chega ao Django. Obrigatória; prod.py recusa
# vazia, inválida ou 0.0.0.0/0. O valor abaixo é um exemplo: troque pela rede real do ambiente.
GIRO_PROXIES_CONFIAVEIS=1
GIRO_REDES_PROXY=10.10.0.0/24
# Geradas por ambiente e guardadas no cofre (comandos em .env.example). Não reutilize as de outro ambiente.
GIRO_CHAVE_DADOS_PESSOAIS=
GIRO_CHAVE_SEGREDOS=
GIRO_PEPPER_HMAC=
# Papéis separados (ADR 0016): giro_app em DATABASE_URL; giro_migracao só no job de deploy.
DATABASE_URL=
DATABASE_URL_MIGRACAO=
# Integrações reais (T-157): prod.py recusa e-mail no console, locmem, arquivo ou dummy,
# SMTP sem EMAIL_HOST, armazenamento diferente de s3 e pagamentos falso ou sem chave.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
GIRO_ARMAZENAMENTO=s3
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGIAO=
S3_CHAVE_DE_ACESSO=
S3_CHAVE_SECRETA=
GIRO_PROVEDOR_PAGAMENTOS=asaas
GIRO_ASAAS_URL=https://api.asaas.com/v3
GIRO_ASAAS_CHAVE_API=
SENTRY_ENVIRONMENT=producao
