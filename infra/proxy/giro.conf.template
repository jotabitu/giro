# Proxy reverso de homologação e produção (T-158, M-04; ADR 0013 e 0018).
#
# Modelo do nginx: a imagem oficial troca ${VARIAVEL} ao subir (pasta /etc/nginx/templates).
# Variáveis: DOMINIO_BASE (girolocadoras.com.br), SUBDOMINIO_PLATAFORMA (admin), BACKEND_UPSTREAM
# (host:porta do Django), FRONTEND_UPSTREAM (host:porta do Next), ESTATICOS_DIR (collectstatic do
# backend, ADR 0027) e CERT_DIR (pasta de fullchain.pem e privkey.pem do certificado curinga). O
# corpo comum dos servidores está em snippets/giro-locais.conf.template. Este arquivo é a
# referência do comportamento; se o ambiente usar outro proxy, a lista de `infra/README.md`
# ("Proxy reverso") diz o que ele precisa fazer igual.

# Rate limit de borda por IP. A chave é o IP da conexão (o proxy é a primeira parada).
limit_req_zone $binary_remote_addr zone=giro_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=giro_webhook:10m rate=120r/m;
# Leitura de PDF (ADR 0026): cada chamada abre um processo filho no Django. A aplicação limita
# 30 por hora por usuário e 200 por hora por empresa; a borda só segura rajada por IP.
limit_req_zone $binary_remote_addr zone=giro_leitura:10m rate=20r/m;
limit_req_status 429;
limit_conn_status 429;

# Django Admin da plataforma (T-291, ADR 0029): só os IPs do arquivo do cofre entram. O arquivo
# traz linhas `203.0.113.10 1;` (ou faixas `203.0.113.0/24 1;`). Vazio = Admin fechado.
geo $admin_permitido {
    default 0;
    include /etc/nginx/admin-ips.conf;
}

# Host desconhecido não chega ao Django.
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate     ${CERT_DIR}/fullchain.pem;
    ssl_certificate_key ${CERT_DIR}/privkey.pem;
    return 444;
}

server {
    listen 80;
    server_name ${DOMINIO_BASE} *.${DOMINIO_BASE};
    return 301 https://$host$request_uri;
}

# Hosts das empresas (<subdominio>.<DOMINIO_BASE>): /admin/ é a Administração da locadora, no Next.
server {
    listen 443 ssl;
    http2 on;
    server_name *.${DOMINIO_BASE};

    include /etc/nginx/conf.d/snippets/giro-locais.conf;
}

# Host da plataforma (nome exato vence o curinga): as mesmas rotas e o Django Admin em /admin/.
server {
    listen 443 ssl;
    http2 on;
    server_name ${SUBDOMINIO_PLATAFORMA}.${DOMINIO_BASE};

    # Fora da lista de IPs, 404 (e não 403, para não confirmar que o Admin existe). Os dois
    # `if` só fazem `return`, o uso seguro do `if` no nginx.
    location /admin/ {
        if ($admin_permitido = 0) { return 404; }
        add_header X-Robots-Tag "noindex, nofollow" always;
        proxy_read_timeout 60s;
        proxy_pass http://${BACKEND_UPSTREAM};
    }

    # Login do Admin com o mesmo limite de /api/auth/ (10 por minuto por IP).
    location = /admin/login/ {
        if ($admin_permitido = 0) { return 404; }
        add_header X-Robots-Tag "noindex, nofollow" always;
        limit_req zone=giro_auth burst=10 nodelay;
        proxy_pass http://${BACKEND_UPSTREAM};
    }

    include /etc/nginx/conf.d/snippets/giro-locais.conf;
}
