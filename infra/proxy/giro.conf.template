# Proxy reverso de homologação e produção (T-158, M-04; ADR 0013 e 0018).
#
# Modelo do nginx: a imagem oficial troca ${VARIAVEL} ao subir (pasta /etc/nginx/templates).
# Variáveis: DOMINIO_BASE (giro.ceo), SUBDOMINIO_PLATAFORMA (admin), BACKEND_UPSTREAM
# (host:porta do Django), FRONTEND_UPSTREAM (host:porta do Next), ESTATICOS_DIR (collectstatic do
# backend, ADR 0027), CERT_DIR (pasta de fullchain.pem e privkey.pem do certificado curinga) e
# PAINEL_UPSTREAM (host:porta do painel de monitoramento da VPS, T-506). O
# corpo comum dos servidores está em snippets/giro-locais.conf.template. Este arquivo é a
# referência do comportamento; se o ambiente usar outro proxy, a lista de `infra/README.md`
# ("Proxy reverso") diz o que ele precisa fazer igual.

# Rate limit de borda por IP. A chave é o IP da conexão (o proxy é a primeira parada).
limit_req_zone $binary_remote_addr zone=giro_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=giro_webhook:10m rate=120r/m;
# Leitura de PDF (ADR 0026): cada chamada abre um processo filho no Django. A aplicação limita
# 30 por hora por usuário e 200 por hora por empresa; a borda só segura rajada por IP.
limit_req_zone $binary_remote_addr zone=giro_leitura:10m rate=20r/m;
limit_req_status 429;

# T-506: formato dos acessos lido pelo painel de monitoramento da VPS (rota, status, tempo,
# user-agent, país quando a Cloudflare estiver com proxy). Usado no snippet giro-locais.
log_format painel escape=json
  '{"t":"$time_iso8601","ip":"$remote_addr","m":"$request_method","u":"$uri",'
  '"s":$status,"b":$body_bytes_sent,"rt":$request_time,'
  '"ua":"$http_user_agent","cc":"$http_cf_ipcountry","h":"$host"}';

# T-478: o DNS do Docker é consultado a cada 10 s, não só ao subir. Com proxy_pass por variável
# (definidas no snippet), o backend ou o frontend recriado com outro IP volta a ser achado sem
# `nginx -s reload`. proxy_pass com variável e sem URI repassa o URI do cliente como hoje.
resolver 127.0.0.11 valid=10s ipv6=off;
limit_conn_status 429;

# Django Admin da plataforma (T-291, ADR 0029): só os IPs do arquivo do cofre entram. O arquivo
# traz linhas `203.0.113.10 1;` (ou faixas `203.0.113.0/24 1;`). Vazio = Admin fechado.
geo $admin_permitido {
    default 0;
    include /etc/nginx/admin-ips.conf;
}

# Host desconhecido não chega ao Django.
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate     ${CERT_DIR}/fullchain.pem;
    ssl_certificate_key ${CERT_DIR}/privkey.pem;
    return 444;
}

server {
    listen 80;
    server_name ${DOMINIO_BASE} *.${DOMINIO_BASE};
    return 301 https://$host$request_uri;
}

# www (T-489, decisão do dono): vai para o domínio raiz com 301, mantendo caminho e query. Na
# porta 80 já direto para https://DOMINIO_BASE, sem dois saltos (nome exato vence o curinga).
server {
    listen 80;
    server_name www.${DOMINIO_BASE};
    return 301 https://${DOMINIO_BASE}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name www.${DOMINIO_BASE};

    # Só pelo certificado; o return no nível do server responde antes de qualquer location.
    include /etc/nginx/conf.d/snippets/giro-locais.conf;
    return 301 https://${DOMINIO_BASE}$request_uri;
}

# Landing pública (T-489): DOMINIO_BASE. Sem este bloco o domínio raiz caía no default_server
# (444). O certificado já cobre DOMINIO_BASE e *.DOMINIO_BASE. O Next mostra a landing em "/"
# (src/lib/host-landing.ts); /api/ aqui responde 404 no Django (nenhuma empresa tem esse domínio).
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMINIO_BASE};

    include /etc/nginx/conf.d/snippets/giro-locais.conf;
}

# Painel de monitoramento da VPS (T-506): binário fora do Giro, no host, em PAINEL_UPSTREAM
# (host.docker.internal = gateway do Docker, extra_hosts no compose). Nome exato vence o curinga;
# "painel" está nos SUBDOMINIOS_RESERVADOS. O painel tem login próprio com 2FA. Se ele estiver
# parado, só este host responde 502; o Giro não depende dele.
server {
    listen 443 ssl;
    http2 on;
    server_name painel.${DOMINIO_BASE};

    ssl_certificate     ${CERT_DIR}/fullchain.pem;
    ssl_certificate_key ${CERT_DIR}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    client_max_body_size 5m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    proxy_http_version 1.1;
    proxy_set_header Host       $host;
    proxy_set_header X-Real-IP  $remote_addr;
    proxy_set_header Connection "";

    # Telemetria ao vivo (SSE): sem buffer, conexão longa.
    location = /api/live {
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_pass http://${PAINEL_UPSTREAM};
    }

    # Login com o mesmo limite de /api/auth/ do Giro (10 por minuto por IP).
    location = /api/login {
        limit_req zone=giro_auth burst=10 nodelay;
        proxy_pass http://${PAINEL_UPSTREAM};
    }

    location / {
        proxy_pass http://${PAINEL_UPSTREAM};
    }
}

# Hosts das empresas (<subdominio>.<DOMINIO_BASE>): /admin/ é a Administração da locadora, no Next.
server {
    listen 443 ssl;
    http2 on;
    server_name *.${DOMINIO_BASE};

    include /etc/nginx/conf.d/snippets/giro-locais.conf;
}

# Host da plataforma (nome exato vence o curinga): as mesmas rotas e o Django Admin em /admin/.
server {
    listen 443 ssl;
    http2 on;
    server_name ${SUBDOMINIO_PLATAFORMA}.${DOMINIO_BASE};

    # Fora da lista de IPs, 404 (e não 403, para não confirmar que o Admin existe). Os dois
    # `if` só fazem `return`, o uso seguro do `if` no nginx.
    location /admin/ {
        if ($admin_permitido = 0) { return 404; }
        add_header X-Robots-Tag "noindex, nofollow" always;
        proxy_read_timeout 60s;
        proxy_pass http://$giro_backend;
    }

    # Login do Admin com o mesmo limite de /api/auth/ (10 por minuto por IP).
    location = /admin/login/ {
        if ($admin_permitido = 0) { return 404; }
        add_header X-Robots-Tag "noindex, nofollow" always;
        limit_req zone=giro_auth burst=10 nodelay;
        proxy_pass http://$giro_backend;
    }

    include /etc/nginx/conf.d/snippets/giro-locais.conf;
}
