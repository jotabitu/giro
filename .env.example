# Giro: variáveis de ambiente. Copie para .env (make up faz isso sozinho).
# Nunca coloque valor real aqui. Segredo de verdade só em .env local ou no cofre do ambiente.

# --- Domínio e multiempresa (ADR 0002) ---
# Em dev use localhost: admin.localhost e <subdominio>.localhost resolvem para a máquina.
# Em homologação e produção: girolocadoras.com.br
DOMINIO_BASE=localhost
SUBDOMINIO_PLATAFORMA=admin

# --- Portas expostas no host ---
PORTA_BACKEND=8000
PORTA_FRONTEND=3000
PORTA_POSTGRES=5432
PORTA_REDIS=6379

# --- PostgreSQL 16 ---
POSTGRES_DB=giro
POSTGRES_USER=giro
POSTGRES_PASSWORD=giro-dev-trocar
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://giro:giro-dev-trocar@db:5432/giro

# --- Redis e Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-apenas-trocar-em-qualquer-outro-ambiente
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=.localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://admin.localhost:3000
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://admin.localhost:3000
TZ=America/Sao_Paulo

# --- Frontend (Next.js) ---
# Chamadas do navegador. Em dev o backend responde em localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Chamadas do servidor Next (SSR) dentro da rede do Compose.
API_URL_INTERNA=http://backend:8000
NEXT_TELEMETRY_DISABLED=1

# --- Armazenamento de arquivos compatível com S3 (vazio em dev: usa disco local) ---
S3_ENDPOINT_URL=
S3_BUCKET=giro-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=sa-east-1

# --- E-mail (dev imprime no console) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=Giro <nao-responda@girolocadoras.com.br>

# --- Pagamentos (ADR 0007, Asaas). Vazio em dev: usa a implementação falsa. ---
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_AMBIENTE=sandbox

# --- Sentry (vazio desliga) ---
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=
SENTRY_ENVIRONMENT=dev
